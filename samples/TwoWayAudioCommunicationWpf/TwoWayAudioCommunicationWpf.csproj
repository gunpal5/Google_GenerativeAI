<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <NoWarn>$(NoWarn);NU1701</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MdXaml.Full" Version="1.27.0" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
      <PackageReference Include="NAudio" Version="3.3.0" />
      <PackageReference Include="PvRecorder" Version="1.2.13" />
      <PackageReference Include="WPF-UI" Version="4.3.0" />
      <!-- Pin transitive dependency to a patched version (GHSA-rxg9-xrhp-64gj, < 4.7.2) -->
      <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\GenerativeAI.Live\GenerativeAI.Live.csproj" />
      <ProjectReference Include="..\..\src\GenerativeAI.Tools\GenerativeAI.Tools.csproj" />
    </ItemGroup>

</Project>
